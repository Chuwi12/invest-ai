# --- Servidor ---
BIND_ADDR=127.0.0.1:8787
# La API no tiene autenticación: el servidor se niega a escuchar fuera de loopback salvo que
# pongas INVEST_AI_ALLOW_REMOTE=1 (expone tus datos y tu GPU a la red; no lo hagas sin un proxy
# con autenticación delante).
INVEST_AI_ALLOW_REMOTE=0
DATABASE_URL=sqlite://data/invest-ai.db
RUST_LOG=info,server=debug,market=debug,ai=debug
# Origen del frontend en desarrollo (CORS)
FRONTEND_ORIGIN=http://localhost:5180

# --- LLM local (Ollama) ---
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
# Contexto en tokens que se pide a Ollama (num_ctx). 16k cabe en 8 GB de VRAM con un 7B Q4.
LLM_NUM_CTX=16384
# Tipo de caché KV con el que corre Ollama (su OLLAMA_KV_CACHE_TYPE): f16 (por defecto), q8_0 o q4_0.
# Solo ajusta los requisitos de VRAM que muestra Ajustes -> Modelos; NO cambia Ollama. q8_0 (con
# OLLAMA_FLASH_ATTENTION=1) reduce la caché a la mitad: qwen3:8b con 16k pasa de ~7,7 a ~6,7 GB.
LLM_KV_CACHE_TYPE=f16
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECS=180
# Idioma de las respuestas
LLM_LANGUAGE=es

# --- Proveedores de datos (todas opcionales) ---
# Sin claves funcionan: Yahoo, Binance, CoinGecko, Google News RSS y SEC EDGAR (GDELT, opcional: MARKET_GDELT).
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
# GDELT (noticias globales, sin clave): desactivado por defecto porque desde muchas redes responde 429
# y tarda 7-10 s solo en el TLS. 1 = activarlo (va en segundo plano y no retrasa las respuestas).
MARKET_GDELT=0
NEWSAPI_API_KEY=
MARKETAUX_API_KEY=
CRYPTOPANIC_API_KEY=
# SEC EDGAR exige un User-Agent con contacto
SEC_USER_AGENT="invest-ai contacto@example.com"

# --- Operación (./invest-ai) ---
# No abrir el navegador al arrancar
INVEST_AI_NO_BROWSER=0
# Arrancar "ollama serve" si no responde (0 = exigir que ya esté en marcha)
INVEST_AI_OLLAMA_AUTOSTART=1

# --- Archivo de conocimiento local / RAG (crate knowledge; ver docs/notes/rag.md) ---
# Apagado hasta descargar el modelo (ollama pull <modelo>; este crate nunca descarga nada).
RAG_ENABLED=0
# Modelo de embeddings en Ollama. Recomendado: embeddinggemma:300m-qat-q8_0 (338 MB, 768 dim, multilingüe).
# Alternativa más pesada: qwen3-embedding:0.6b (639 MB, 1024 dim). Cambiar de modelo deja los vectores
# viejos sin usar y los recalcula (embed_pending); nunca se mezclan espacios vectoriales.
RAG_EMBED_MODEL=embeddinggemma:300m-qat-q8_0
# Opcionales: RAG_EMBED_BASE_URL (def. LLM_BASE_URL), RAG_EMBED_DIMS (trunca Matryoshka, p. ej. 512),
# RAG_EMBED_BATCH=16, RAG_EMBED_KEEP_ALIVE=2m, RAG_EMBED_TIMEOUT_SECS=120, RAG_EMBED_NUM_GPU (0 = CPU),
# RAG_EMBED_PROMPT_STYLE=auto|none|nomic|gemma|qwen3
# Troceado (tokens estimados) y recuperación
RAG_CHUNK_TARGET_TOKENS=400
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=6
# Retención (días; 0 = indefinida) y tope duro de fragmentos (~3 KB de RAM por fragmento a 768 dim)
RAG_NEWS_RETENTION_DAYS=90
RAG_FILING_RETENTION_DAYS=1095
RAG_ANALYSIS_RETENTION_DAYS=0
RAG_MAX_CHUNKS=100000
