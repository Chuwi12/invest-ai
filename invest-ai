#!/usr/bin/env bash
# invest-ai: un solo comando para levantar toda la aplicación (Ollama + backend + frontend).
# Uso: ./invest-ai [--fake] [--no-browser] [run|dev|stop|status|logs|open|pull|install|uninstall|help]
set -Eeuo pipefail

SELF_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd -- "$(dirname -- "$SELF_PATH")" && pwd -P)"
readonly SELF_PATH SELF_DIR
ROOT="$SELF_DIR"
# La copia que `install` deja en releases/<id>/invest-ai (lleva un fichero VERSION al lado) la ejecuta
# el servicio como ExecStartPre. Su carpeta es solo de lectura y no contiene .env ni data/: trabaja
# sobre el proyecto que le indica la unidad en INVEST_AI_ROOT. Un script suelto del repo lo ignora.
if [[ -f $SELF_DIR/VERSION && -n ${INVEST_AI_ROOT-} ]]; then
  ROOT="$(cd -- "$INVEST_AI_ROOT" && pwd -P)" || { printf 'error: INVEST_AI_ROOT no es una carpeta: %s\n' "$INVEST_AI_ROOT" >&2; exit 1; }
fi
readonly ROOT
readonly ENV_FILE="$ROOT/.env"
readonly ENV_EXAMPLE="$ROOT/.env.example"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/invest-ai"
readonly TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/backend/target}" # cargo lo respeta; el script debe buscar el binario ahí
readonly BIN="$TARGET_DIR/release/invest-ai"
readonly SELFTEST_BIN="$TARGET_DIR/release/invest-ai-selftest"
readonly BIN_DEBUG="$TARGET_DIR/debug/invest-ai"
readonly SERVER_LOG="$STATE_DIR/server.log"
readonly OLLAMA_LOG="$STATE_DIR/ollama.log"
readonly RUN_PID="$STATE_DIR/run.pid"
readonly OLLAMA_PID="$STATE_DIR/ollama.pid"
readonly LOCK_FILE="$STATE_DIR/run.lock"
readonly UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
# Versiones instaladas del servicio (copias inmutables: binario, frontend/dist y este script).
readonly RELEASES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/invest-ai/releases"
readonly APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
readonly ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
readonly SERVICE="invest-ai.service"
readonly OLLAMA_SERVICE="invest-ai-ollama.service"
readonly DEV_PORT=5180

NO_BROWSER=0
FAKE=0
SERVER_PGID=""
VITE_PGID=""
OLLAMA_STARTED_PID=""
CLEANED=0
# Las variables globales de abajo se llaman como las del entorno y las pisarían: se guardan
# antes los valores que vinieron del entorno (si no, `BIND_ADDR=... ./invest-ai` se ignoraba).
declare -A ENV_ORIG=([BIND_ADDR]="${BIND_ADDR-}" [LLM_BASE_URL]="${LLM_BASE_URL-}" [LLM_MODEL]="${LLM_MODEL-}")
BIND_ADDR="" BIND_HOST="" BIND_PORT="" APP_URL="" LLM_BASE_URL="" LLM_MODEL=""
OLLAMA_HOSTPORT="" OLLAMA_LOCAL=0 DATA_DIR=""

# ---------- utilidades ----------
if [[ -t 1 ]]; then
  C_B=$'\033[1m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_0=$'\033[0m'
else
  C_B=""; C_G=""; C_Y=""; C_R=""; C_0=""
fi
info() { printf '%s==>%s %s\n' "$C_B" "$C_0" "$*"; }
ok() { printf '%s ok%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%saviso:%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die() { printf '%serror:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
now() { printf '%s' "${EPOCHREALTIME/,/.}"; }
elapsed() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.1f", b - a }'; }

# Lee CLAVE del entorno o de .env (sin cargar el fichero como código) o usa el valor por defecto.
env_get() {
  local key=$1 def=${2-} val="" line
  if [[ -n ${ENV_ORIG[$key]-} ]]; then
    printf '%s' "${ENV_ORIG[$key]}"
    return 0
  fi
  if [[ -n ${!key-} ]]; then
    printf '%s' "${!key}"
    return 0
  fi
  if [[ -r $ENV_FILE ]]; then
    line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}=" "$ENV_FILE" | tail -n 1 || true)
    if [[ -n $line ]]; then
      val=${line#*=}
      val=${val#"${val%%[![:space:]]*}"}
      val=${val%"${val##*[![:space:]]}"}
      if [[ $val =~ ^\"(.*)\"$ || $val =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}; fi
    fi
  fi
  printf '%s' "${val:-$def}"
}

is_loopback() {
  [[ $1 == localhost || $1 == "[::1]" || $1 == "::1" || $1 =~ ^127\.[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

load_settings() {
  BIND_ADDR="$(env_get BIND_ADDR 127.0.0.1:8787)"
  BIND_HOST="${BIND_ADDR%:*}"
  BIND_PORT="${BIND_ADDR##*:}"
  is_loopback "$BIND_HOST" || die "BIND_ADDR=$BIND_ADDR no es loopback: por seguridad el servidor solo puede escuchar en 127.0.0.1/::1."
  [[ $BIND_PORT =~ ^[0-9]+$ ]] || die "BIND_ADDR=$BIND_ADDR no tiene un puerto válido."
  APP_URL="http://$BIND_HOST:$BIND_PORT"
  LLM_BASE_URL="$(env_get LLM_BASE_URL http://127.0.0.1:11434)"
  LLM_BASE_URL="${LLM_BASE_URL%/}"
  LLM_MODEL="$(env_get LLM_MODEL qwen2.5:7b)"
  local hostport=${LLM_BASE_URL#*://}
  hostport=${hostport%%/*}
  OLLAMA_HOSTPORT=$hostport
  OLLAMA_LOCAL=0
  if is_loopback "${hostport%:*}"; then OLLAMA_LOCAL=1; fi
  if [[ $(env_get INVEST_AI_NO_BROWSER 0) == 1 ]]; then NO_BROWSER=1; fi
  if [[ $(env_get INVEST_AI_FAKE 0) =~ ^(1|true|TRUE|yes)$ ]]; then FAKE=1; fi
  local db
  db="$(env_get DATABASE_URL sqlite://data/invest-ai.db)"
  db=${db#sqlite://}
  db=${db#sqlite:}
  db=${db%%\?*}
  DATA_DIR="$(dirname -- "$db")"
  [[ $DATA_DIR == /* ]] || DATA_DIR="$ROOT/$DATA_DIR"
  if [[ $DATA_DIR == "$ROOT/." ]]; then DATA_DIR="$ROOT/data"; fi
  return 0
}

app_up() { curl -fsS --max-time 2 -o /dev/null "$APP_URL/api/health" 2>/dev/null; }
ollama_up() { curl -fsS --max-time 2 -o /dev/null "$LLM_BASE_URL/api/version" 2>/dev/null; }
vite_up() { curl -fsS --max-time 2 -o /dev/null "http://127.0.0.1:$DEV_PORT/" 2>/dev/null; }

wait_for() { # wait_for SEGUNDOS COMANDO... ; devuelve 0 en cuanto el comando tenga éxito
  local secs=$1 end
  shift
  end=$(( SECONDS + secs ))
  while (( SECONDS < end )); do
    if "$@"; then return 0; fi
    sleep 0.05
  done
  "$@"
}

pid_alive() { [[ -n ${1-} ]] && kill -0 "$1" 2>/dev/null; }

# Termina un grupo de procesos (creado con setsid): TERM, espera, KILL.
kill_group() {
  local pgid=$1 grace=${2:-12} end
  pid_alive "$pgid" || return 0
  kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pgid" 2>/dev/null || true
  end=$(( SECONDS + grace ))
  while pid_alive "$pgid" && (( SECONDS < end )); do sleep 0.2; done
  if pid_alive "$pgid"; then
    warn "el proceso $pgid no terminó a tiempo: SIGKILL"
    kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pgid" 2>/dev/null || true
  fi
  return 0
}

exe_is() { [[ $(readlink -f "/proc/$1/exe" 2>/dev/null || true) == "$2" ]]; }

server_pids() { # PIDs de binarios invest-ai (release, debug o versión instalada) de este repo
  local p exe
  for p in $(pgrep -u "$UID" -x invest-ai || true); do
    exe=$(readlink -f "/proc/$p/exe" 2>/dev/null || true)
    if [[ $exe == "$BIN" || $exe == "$BIN_DEBUG" || $exe == "$RELEASES_DIR"/*/bin/invest-ai ]]; then printf '%s\n' "$p"; fi
  done
}

port_busy() { ss -ltn 2>/dev/null | awk -v p=":$1\$" '$4 ~ p { f = 1 } END { exit !f }'; }

open_url() {
  if (( NO_BROWSER )); then
    info "Abre $1"
  elif have xdg-open; then
    (setsid xdg-open "$1" >/dev/null 2>&1 9>&- &)
  else
    warn "no hay xdg-open: abre $1 a mano"
  fi
}

service_installed() { [[ -f $UNIT_DIR/$SERVICE ]]; }
service_active() { have systemctl && systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; }

# ---------- preparación ----------
check_prereqs() {
  local missing=0
  if ! have cargo; then
    printf '  falta cargo: sudo pacman -S rust   (o rustup: https://rustup.rs)\n' >&2; missing=1
  fi
  if ! have node || ! have npm; then
    printf '  falta node/npm: sudo pacman -S nodejs npm\n' >&2; missing=1
  fi
  if (( ! FAKE )) && ! have ollama; then
    printf '  falta ollama: sudo pacman -S ollama   (con GPU NVIDIA: ollama-cuda)\n' >&2; missing=1
  fi
  have curl || { printf '  falta curl: sudo pacman -S curl\n' >&2; missing=1; }
  have flock || { printf '  falta flock: sudo pacman -S util-linux\n' >&2; missing=1; }
  (( missing == 0 )) || die "instala los prerequisitos anteriores (el script no usa sudo)."
}

prepare_files() {
  mkdir -p -- "$STATE_DIR"
  chmod 700 -- "$STATE_DIR"
  if [[ ! -f $ENV_FILE ]]; then
    [[ -f $ENV_EXAMPLE ]] || die "falta $ENV_EXAMPLE"
    install -m 600 -- "$ENV_EXAMPLE" "$ENV_FILE"
    ok ".env creado desde .env.example (permisos 600); edítalo para añadir claves de API (opcionales)"
  elif [[ $(stat -c %a -- "$ENV_FILE") != 600 ]]; then
    chmod 600 -- "$ENV_FILE"
    warn ".env tenía permisos abiertos: ahora 600"
  fi
  load_settings
  check_data_dir
  mkdir -p -- "$DATA_DIR"
  chmod 700 -- "$DATA_DIR"
  # El log del servidor no crece sin límite.
  if [[ -f $SERVER_LOG ]] && (( $(stat -c %s -- "$SERVER_LOG") > 10485760 )); then
    tail -c 1048576 -- "$SERVER_LOG" >"$SERVER_LOG.tmp" && mv -f -- "$SERVER_LOG.tmp" "$SERVER_LOG"
  fi
  return 0
}

# Huella barata de un conjunto de ficheros: ruta + tamaño + mtime.
fingerprint() { # fingerprint DIR [filtros de find...]
  local dir=$1
  shift
  find "$dir" "$@" -printf '%P %s %T@\n' | LC_ALL=C sort | sha256sum | cut -d' ' -f1
}
# `-prune` evita recorrer target/ y node_modules/ (con `-not -path` find los recorre igualmente:
# 158 ms -> 4 ms en backend/). La huella resultante es idéntica.
backend_fp() { fingerprint "$ROOT/backend" -name target -prune -o -type f; }
frontend_fp() { fingerprint "$ROOT/frontend" \( -name node_modules -o -name dist \) -prune -o -type f -not -name '*.tsbuildinfo'; }

stamp_is() { [[ -f $STATE_DIR/$1 && $(<"$STATE_DIR/$1") == "$2" ]]; }

ensure_ollama() {
  if (( FAKE )); then return 0; fi
  if ollama_up; then
    ok "Ollama ya responde en $LLM_BASE_URL"
    return 0
  fi
  (( OLLAMA_LOCAL )) || die "Ollama no responde en $LLM_BASE_URL (no es local: arráncalo tú)."
  [[ $(env_get INVEST_AI_OLLAMA_AUTOSTART 1) == 1 ]] || die "Ollama no responde en $LLM_BASE_URL y INVEST_AI_OLLAMA_AUTOSTART=0."
  have ollama || die "falta ollama (sudo pacman -S ollama)."
  info "Arrancando Ollama (ollama serve)"
  if [[ -n $(systemctl list-unit-files ollama.service --no-legend 2>/dev/null || true) ]]; then
    warn "existe ollama.service del sistema pero está parado; arrancarlo exige sudo (sudo systemctl enable --now ollama). Uso un 'ollama serve' propio."
  fi
  : >>"$OLLAMA_LOG"
  chmod 600 -- "$OLLAMA_LOG"
  OLLAMA_HOST="$OLLAMA_HOSTPORT" setsid ollama serve >>"$OLLAMA_LOG" 2>&1 9>&- &
  OLLAMA_STARTED_PID=$!
  printf '%s\n' "$OLLAMA_STARTED_PID" >"$OLLAMA_PID"
  wait_for 60 ollama_up || die "Ollama no respondió en 60 s; mira ./invest-ai logs ollama"
  ok "Ollama listo (arrancado por este script)"
}

# ---------- modelos de Ollama: NUNCA se descarga nada sin consentimiento ----------
# Un modelo pesa gigas y se descarga en el almacén del Ollama que responda en ese momento (que puede
# no ser el que el usuario cree: ver docs/notes/ops.md, «carrera de los dos Ollama»). Por eso solo se
# descarga si el usuario lo pide (`./invest-ai pull`, la UI de Modelos), si lo confirma en un arranque
# interactivo o si activó AUTO_PULL_MODEL=1 en .env (desactivado por defecto).
auto_pull() { [[ $(env_get AUTO_PULL_MODEL 0) =~ ^(1|true|TRUE|yes)$ ]]; }

# ¿Hay un ollama.service del sistema habilitado? (lectura: no necesita sudo)
system_ollama_enabled() { have systemctl && systemctl --system is-enabled --quiet ollama.service 2>/dev/null; }

# model_state MODELO: 0 = instalado, 1 = falta, 2 = no se pudo consultar a Ollama.
model_state() {
  local model=$1 tags
  [[ $model == *:* ]] || model="$model:latest"
  tags=$(curl -fsS --max-time 5 "$LLM_BASE_URL/api/tags" 2>/dev/null) || return 2
  grep -qF "\"name\":\"$model\"" <<<"$tags" || return 1
  return 0
}

# Nombre de modelo de Ollama: ASCII estricto (con LC_ALL=C; en es_ES.UTF-8 [A-Za-z] aceptaría «á») y sin «-» inicial.
valid_model() { local LC_ALL=C; [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._/:-]*$ && ${#1} -le 200 ]]; }

# Descarga con `ollama pull` contra el Ollama de LLM_BASE_URL. Devuelve 1 si falla. Es el ÚNICO punto que
# valida el nombre (LLM_MODEL viene del entorno o de .env y ensure_model también llega aquí).
pull_model() {
  local model=$1
  if ! valid_model "$model"; then
    warn "nombre de modelo no válido, no se descarga: $model"
    return 1
  fi
  info "Descargando el modelo $model en el Ollama de $LLM_BASE_URL"
  if OLLAMA_HOST="$OLLAMA_HOSTPORT" ollama pull -- "$model"; then
    ok "modelo $model descargado"
    return 0
  fi
  warn "no se pudo descargar $model (reintenta con ./invest-ai pull $model)"
  return 1
}

# ensure_model INTERACTIVO(1|0): comprueba LLM_MODEL. Si falta, avisa y SIGUE; solo descarga con
# AUTO_PULL_MODEL=1 o, si es interactivo y hay terminal, tras preguntar. Nunca falla.
ensure_model() {
  if (( FAKE )); then return 0; fi
  local interactive=${1:-0} rc=0 ans=""
  model_state "$LLM_MODEL" || rc=$?
  case $rc in
    0) ok "modelo $LLM_MODEL disponible"; return 0 ;;
    2) warn "no pude consultar los modelos de Ollama en $LLM_BASE_URL; sigo sin comprobar $LLM_MODEL"; return 0 ;;
  esac
  warn "el modelo $LLM_MODEL no está instalado en el Ollama de $LLM_BASE_URL"
  if auto_pull; then
    info "AUTO_PULL_MODEL=1: se descarga sin preguntar"
    pull_model "$LLM_MODEL" || true
    return 0
  fi
  if (( interactive )) && [[ -t 0 && -t 1 ]]; then
    read -r -t 120 -p "¿Descargar $LLM_MODEL ahora (varios GB)? [s/N] " ans || ans=""
    if [[ $ans =~ ^([sSyY]|[sS][ií]|[yY]es)$ ]]; then
      pull_model "$LLM_MODEL" || true
      return 0
    fi
  fi
  warn "sigo sin descargar: el análisis con IA no funcionará hasta que lo instales (./invest-ai pull, o Ajustes -> Modelos en la app)"
  return 0
}

ensure_frontend() { # ensure_frontend [1=compilar | 0=solo dependencias]
  local lock_hash fp
  lock_hash=$(cat -- "$ROOT/frontend/package.json" "$ROOT/frontend/package-lock.json" | sha256sum | cut -d' ' -f1)
  if [[ ! -d $ROOT/frontend/node_modules ]] || ! stamp_is npm.stamp "$lock_hash"; then
    info "Instalando dependencias del frontend (npm ci)"
    (cd -- "$ROOT/frontend" && npm ci --no-audit --no-fund)
    printf '%s' "$lock_hash" >"$STATE_DIR/npm.stamp"
  fi
  if (( ! ${1:-1} )); then return 0; fi
  fp=$(frontend_fp)
  if [[ ! -f $ROOT/frontend/dist/index.html ]] || ! stamp_is frontend.stamp "$fp"; then
    info "Compilando el frontend (vite build)"
    if (cd -- "$ROOT/frontend" && npm run build --silent); then
      printf '%s' "$fp" >"$STATE_DIR/frontend.stamp"
    elif [[ -f $ROOT/frontend/dist/index.html ]]; then
      warn "el frontend no compila: sirvo el dist anterior (npm run build en frontend/ para ver el error)"
    else
      die "el frontend no compila (npm run build en frontend/)."
    fi
  else
    ok "frontend al día"
  fi
}

ensure_backend() { # ensure_backend [release|debug]
  local profile=${1:-release} fp bin stamp args=()
  if [[ $profile == release ]]; then
    bin=$BIN; stamp=backend.stamp; args=(--release)
  else
    bin=$BIN_DEBUG; stamp=backend-debug.stamp
  fi
  fp=$(backend_fp)
  if [[ ! -x $bin ]] || ! stamp_is "$stamp" "$fp"; then
    info "Compilando el backend ($profile; la primera vez tarda minutos)"
    (cd -- "$ROOT/backend" && cargo build "${args[@]}" -p server --bin invest-ai --bin invest-ai-selftest) \
      || die "el backend no compila: corrige los errores de cargo y vuelve a lanzar."
    printf '%s' "$fp" >"$STATE_DIR/$stamp"
  else
    ok "backend al día ($profile)"
  fi
}

# ---------- ejecución y limpieza ----------
cleanup() {
  if (( CLEANED )); then return 0; fi
  CLEANED=1
  trap - INT TERM HUP
  local started=0
  if [[ -n $SERVER_PGID || -n $VITE_PGID || -n $OLLAMA_STARTED_PID ]]; then started=1; fi
  if (( started )); then printf '\n'; fi
  if [[ -n $VITE_PGID ]]; then kill_group "$VITE_PGID" 5; fi
  if [[ -n $SERVER_PGID ]]; then
    info "Parando el servidor"
    kill_group "$SERVER_PGID" 14
  fi
  if [[ -n $OLLAMA_STARTED_PID ]]; then
    info "Parando el Ollama que arrancó este script"
    kill_group "$OLLAMA_STARTED_PID" 8
    rm -f -- "${OLLAMA_PID:?}"
  fi
  rm -f -- "${RUN_PID:?}"
  if (( started )); then ok "parado limpiamente"; fi
  return 0
}

install_traps() {
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
}

acquire_lock() {
  mkdir -p -- "$STATE_DIR"
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    info "Otra instancia está arrancando; espero a que esté lista"
    wait_for 120 app_up || die "la otra instancia no llegó a responder"
    open_url "$APP_URL"
    exit 0
  fi
}

already_running() { # si la app ya responde: abre el navegador y sale
  if app_up; then
    ok "invest-ai ya está en marcha en $APP_URL"
    open_url "$APP_URL"
    exit 0
  fi
  return 0
}

start_server() { # start_server BINARIO
  if port_busy "$BIND_PORT"; then
    die "el puerto $BIND_PORT está ocupado por otro proceso que no es invest-ai (ss -ltnp | grep $BIND_PORT)."
  fi
  : >>"$SERVER_LOG"
  chmod 600 -- "$SERVER_LOG"
  if (( FAKE )); then export INVEST_AI_FAKE=1; fi
  export NO_COLOR=1
  (cd -- "$ROOT" && exec setsid "$1" >>"$SERVER_LOG" 2>&1 9>&-) &
  SERVER_PGID=$!
  if ! wait_for 60 app_up; then
    if ! pid_alive "$SERVER_PGID"; then
      tail -n 15 -- "$SERVER_LOG" >&2
      die "el servidor se cerró al arrancar (log: $SERVER_LOG)"
    fi
    die "el servidor no respondió en /api/health en 60 s (log: $SERVER_LOG)"
  fi
}

supervise() { # espera al servidor; Ctrl+C o SIGTERM lo paran vía trap
  while pid_alive "$SERVER_PGID"; do
    wait "$SERVER_PGID" 2>/dev/null || true
    sleep 0.1
  done
  warn "el servidor terminó por su cuenta; mira ./invest-ai logs"
  exit 1
}

cmd_run() {
  local t0 suffix=""
  t0=$(now)
  load_settings
  already_running
  check_prereqs
  acquire_lock
  already_running
  prepare_files
  install_traps
  printf '%s\n' "$$" >"$RUN_PID"
  ensure_ollama
  ensure_model 1
  ensure_frontend 1
  ensure_backend release
  if (( FAKE )); then suffix=" (datos simulados)"; fi
  info "Arrancando el servidor en $APP_URL$suffix"
  start_server "$BIN"
  ok "listo en $(elapsed "$t0") s -> $APP_URL   (Ctrl+C para parar; ./invest-ai logs -f)"
  open_url "$APP_URL"
  supervise
}

cmd_dev() {
  local t0 vite="$ROOT/frontend/node_modules/.bin/vite"
  t0=$(now)
  load_settings
  already_running
  check_prereqs
  acquire_lock
  already_running
  prepare_files
  install_traps
  printf '%s\n' "$$" >"$RUN_PID"
  if port_busy "$DEV_PORT"; then die "el puerto $DEV_PORT (Vite) está ocupado."; fi
  ensure_ollama
  ensure_model 1
  ensure_frontend 0
  ensure_backend debug
  info "Arrancando el backend (debug) en $APP_URL"
  start_server "$BIN_DEBUG"
  info "Arrancando Vite con HMR en http://localhost:$DEV_PORT"
  : >>"$STATE_DIR/vite.log"
  chmod 600 -- "$STATE_DIR/vite.log"
  (cd -- "$ROOT/frontend" && exec setsid "$vite" --host 127.0.0.1 >>"$STATE_DIR/vite.log" 2>&1 9>&-) &
  VITE_PGID=$!
  wait_for 30 vite_up || die "Vite no respondió (log: $STATE_DIR/vite.log)"
  ok "listo en $(elapsed "$t0") s -> http://localhost:$DEV_PORT   (Ctrl+C para parar todo)"
  open_url "http://localhost:$DEV_PORT"
  supervise
}

# ---------- parar, estado, logs ----------
cmd_stop() {
  load_settings
  local pid p stopped=0 end
  if service_active; then
    info "Parando $SERVICE"
    systemctl --user stop "$SERVICE"
    stopped=1
  fi
  pid=$(cat -- "$RUN_PID" 2>/dev/null || true)
  if pid_alive "$pid" && [[ $(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true) == *invest-ai* ]]; then
    info "Parando la instancia $pid"
    kill -TERM "$pid"
    end=$(( SECONDS + 30 ))
    while pid_alive "$pid" && (( SECONDS < end )); do sleep 0.2; done
    if pid_alive "$pid"; then warn "la instancia $pid no terminó en 30 s"; fi
    stopped=1
  fi
  for p in $(server_pids); do
    info "Parando servidor huérfano $p"
    kill -TERM "$p" 2>/dev/null || true
    end=$(( SECONDS + 12 ))
    while pid_alive "$p" && (( SECONDS < end )); do sleep 0.2; done
    kill -KILL "$p" 2>/dev/null || true
    stopped=1
  done
  pid=$(cat -- "$OLLAMA_PID" 2>/dev/null || true)
  if pid_alive "$pid" && [[ $(readlink -f "/proc/$pid/exe" 2>/dev/null || true) == */ollama ]]; then
    info "Parando el Ollama que arrancó este script ($pid)"
    kill_group "$pid" 8
    stopped=1
  fi
  rm -f -- "${OLLAMA_PID:?}" "${RUN_PID:?}"
  if (( stopped )); then ok "parado"; else ok "no había nada en marcha"; fi
}

cmd_status() {
  load_settings
  local pid mode
  if app_up; then
    pid=$(cat -- "$RUN_PID" 2>/dev/null || true)
    if service_active; then mode="servicio systemd"
    elif pid_alive "$pid"; then mode="./invest-ai, pid $pid"
    else mode="externo"; fi
    printf 'app:      %sEN MARCHA%s  %s  [%s] servidor pid: %s\n' "$C_G" "$C_0" "$APP_URL" "$mode" "$(server_pids | tr '\n' ' ')"
    printf '          health: %s\n' "$(curl -fsS --max-time 2 "$APP_URL/api/health" 2>/dev/null | head -c 200)"
  else
    printf 'app:      %sparada%s  (%s)\n' "$C_Y" "$C_0" "$APP_URL"
  fi
  if ollama_up; then
    pid=$(cat -- "$OLLAMA_PID" 2>/dev/null || true)
    mode=""
    if pid_alive "$pid"; then mode=" (lo arrancó invest-ai, pid $pid)"; fi
    printf 'ollama:   %sresponde%s en %s%s\n' "$C_G" "$C_0" "$LLM_BASE_URL" "$mode"
    printf 'modelo:   %s\n' "$LLM_MODEL"
    local mrc=0
    model_state "$LLM_MODEL" || mrc=$?
    if (( mrc == 1 )); then
      printf '          %sno está instalado%s en este Ollama (./invest-ai pull)\n' "$C_Y" "$C_0"
    fi
    if have ollama; then
      local ps_out
      ps_out=$(OLLAMA_HOST="$OLLAMA_HOSTPORT" ollama ps 2>/dev/null || true)
      sed 's/^/          /' <<<"$ps_out"
      if grep -q 'CPU' <<<"$ps_out"; then
        warn "el modelo corre (en parte) en CPU: sin 'ollama-cuda' (sudo pacman -S ollama-cuda) Ollama no usa la GPU"
      fi
    fi
  else
    printf 'ollama:   %sno responde%s en %s\n' "$C_Y" "$C_0" "$LLM_BASE_URL"
  fi
  if service_installed; then
    printf 'servicio: instalado, activo=%s, autoarranque=%s\n' "$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)" "$(systemctl --user is-enabled "$SERVICE" 2>/dev/null || true)"
    local rel
    rel=$(installed_release || true)
    if [[ -z $rel ]]; then
      printf '          %sla unidad ejecuta el árbol de trabajo (instalación antigua)%s: ./invest-ai install la pasa a una versión instalada\n' "$C_Y" "$C_0"
    elif [[ ! -f $rel/VERSION ]]; then
      printf '          %sla versión instalada %s no existe%s: repite ./invest-ai install (sin ella el servicio no arranca)\n' "$C_R" "$(basename -- "$rel")" "$C_0"
    else
      printf '          versión instalada: %s (%s)\n' "$(basename -- "$rel")" "$(sed -n 's/^commit=//p' "$rel/VERSION" | head -n 1)"
      if [[ -x $BIN && -f $ROOT/frontend/dist/index.html && $(basename -- "$rel") != "$(release_id)" ]]; then
        printf '          %sel árbol de trabajo tiene otra build%s: ./invest-ai install la instala (y systemctl --user restart %s la aplica)\n' "$C_Y" "$C_0" "$SERVICE"
      fi
    fi
  else
    printf 'servicio: no instalado (./invest-ai install)\n'
  fi
  if [[ -x $BIN && -f $ROOT/frontend/dist/index.html ]]; then
    if stamp_is backend.stamp "$(backend_fp)"; then printf 'backend:  binario al día\n'; else printf 'backend:  hay cambios sin compilar (se recompila al arrancar)\n'; fi
    if stamp_is frontend.stamp "$(frontend_fp)"; then printf 'frontend: dist al día\n'; else printf 'frontend: hay cambios sin compilar (se recompila al arrancar)\n'; fi
  else
    printf 'build:    sin compilar todavía\n'
  fi
  printf 'logs:     %s\n' "$STATE_DIR"
}

cmd_logs() {
  local follow=() which=server a
  for a in "$@"; do
    case $a in
      -f|--follow) follow=(-f) ;;
      server|ollama|vite) which=$a ;;
      *) die "uso: ./invest-ai logs [-f] [server|ollama|vite]" ;;
    esac
  done
  if [[ $which == server ]] && service_active; then
    exec journalctl --user -u "$SERVICE" -n 100 --no-pager "${follow[@]}"
  fi
  local f="$STATE_DIR/$which.log"
  [[ -f $f ]] || die "todavía no hay $f"
  exec tail -n 100 "${follow[@]}" -- "$f"
}

# ---------- servicio systemd de usuario + lanzador de KDE ----------
# El servicio NO ejecuta el árbol de trabajo: `install` hace una copia inmutable (binario, frontend/dist
# y este script) en releases/<id>/ y las unidades apuntan allí. Así un cargo build, un npm run build o una
# edición del script no cambian el servicio en marcha ni su próximo reinicio. Lo que sigue en el proyecto
# es la configuración y los datos: .env y data/ (WorkingDirectory + ReadWritePaths).
# Las migraciones y el catálogo de modelos van embebidos en el binario.
REL_DIR="" REL_BIN="" REL_SCRIPT="" REL_DIST=""

# ¿Se puede escribir esta ruta tal cual en una unidad systemd (y en el reemplazo de sed de render)?
unit_safe() { [[ $1 != *[[:space:]%\$\"\'\\\|\&]* ]]; }

# Huella de contenido de lo que se instala: binario + frontend/dist + este script.
release_id() {
  {
    sha256sum <"$BIN"
    sha256sum <"$SELF_PATH"
    (cd -- "$ROOT/frontend/dist" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum)
  } | sha256sum | cut -c1-12
}

# Carpeta de la versión a la que apunta la unidad instalada (vacío si apunta al árbol de trabajo). La carpeta
# puede no existir (borrada a mano): `status` lo distingue de una instalación antigua mirando su VERSION.
installed_release() {
  local exe
  exe=$(sed -n 's/^ExecStart=//p' "$UNIT_DIR/$SERVICE" 2>/dev/null | head -n 1 || true)
  if [[ $exe == "$RELEASES_DIR"/*/bin/invest-ai ]]; then printf '%s\n' "${exe%/bin/invest-ai}"; fi
}

# Crea (o reutiliza, si el contenido es idéntico) releases/<id>/ y fija REL_*.
snapshot_release() {
  local id tmp commit dirty=""
  [[ -x $BIN && -f $ROOT/frontend/dist/index.html ]] \
    || die "falta la compilación (binario o frontend/dist): ejecuta ./invest-ai install sin --no-build."
  id=$(release_id)
  REL_DIR="$RELEASES_DIR/$id"
  REL_BIN="$REL_DIR/bin/invest-ai"
  REL_SCRIPT="$REL_DIR/invest-ai"
  REL_DIST="$REL_DIR/frontend/dist"
  if [[ -f $REL_DIR/VERSION ]]; then
    ok "versión $id ya instalada (el contenido no cambió)"
    return 0
  fi
  [[ ! -e $REL_DIR ]] || die "$REL_DIR existe pero está incompleto: bórralo (chmod -R u+w y rm -rf) y repite."
  mkdir -p -m 700 -- "$RELEASES_DIR"
  tmp=$(mktemp -d -- "$RELEASES_DIR/.tmp-XXXXXX")
  # Si algo falla a mitad de la copia (set -e), no se deja el temporal. ${tmp@Q} se expande ya: la local no existe en el trap.
  trap "rm -rf -- ${tmp@Q}" EXIT
  info "Instalando la versión $id en $REL_DIR"
  mkdir -p -- "$tmp/bin" "$tmp/frontend"
  install -m 755 -- "$BIN" "$tmp/bin/invest-ai"
  install -m 755 -- "$SELF_PATH" "$tmp/invest-ai"
  cp -r -- "$ROOT/frontend/dist" "$tmp/frontend/dist"
  commit=unknown
  if have git && git -C "$ROOT" rev-parse --short HEAD >/dev/null 2>&1; then
    commit=$(git -C "$ROOT" rev-parse --short HEAD)
    if [[ -n $(git -C "$ROOT" status --porcelain 2>/dev/null | head -n 1) ]]; then dirty="+cambios-sin-commit"; fi
  fi
  {
    printf 'id=%s\n' "$id"
    printf 'commit=%s%s\n' "$commit" "$dirty"
    printf 'instalada=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'proyecto=%s\n' "$ROOT"
  } >"$tmp/VERSION"
  mv -T -- "$tmp" "$REL_DIR" || die "no se pudo crear $REL_DIR"
  trap - EXIT
  chmod -R a-w -- "$REL_DIR" # inmutable
}

# Nombres que `install` crea en releases/: la versión (12 hex de release_id) y el temporal de mktemp.
# Clases explícitas: con un locale UTF-8, un rango como a-f puede aceptar letras con tilde.
readonly REL_ID_RE='^[0123456789abcdef]{12}$' REL_TMP_RE='^\.tmp-[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz]{6}$'

# Borra una carpeta de releases/. Es el único sitio que hace chmod -R ahí, y solo sobre un hijo directo, sin
# enlace y con nombre de versión o de temporal: chmod sigue los enlaces de la línea de órdenes.
drop_release() { # drop_release RUTA
  local d=$1 name=${1##*/}
  [[ $d == "$RELEASES_DIR/$name" && ! -L $d && ( $name =~ $REL_ID_RE || $name =~ $REL_TMP_RE ) ]] || return 1
  chmod -R -P u+w -- "$d" && rm -rf -- "${d:?}" # -P: no sigue un enlace que se cuele tras la comprobación
}

# Versión instalada que ejecuta el proceso principal del servicio (vacío si no corre ninguna): su
# STATIC_DIR vive ahí y borrarla deja la UI en 404 hasta el siguiente reinicio.
running_release() {
  local pid exe
  pid=$(systemctl --user show -p MainPID --value "$SERVICE" 2>/dev/null || true)
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 0
  exe=$(readlink -f -- "/proc/$pid/exe" 2>/dev/null || true)
  if [[ $exe == "$RELEASES_DIR"/*/bin/invest-ai ]]; then printf '%s\n' "${exe%/bin/invest-ai}"; fi
}

# Borra las versiones antiguas: se quedan la nueva, la que usaba la unidad hasta ahora, la del proceso en
# marcha y las 3 más recientes. También los .tmp-* abandonados (de más de 1 h) por un install que murió.
# Las listas van separadas por NUL: un nombre con saltos de línea no puede hacerse pasar por otra ruta.
prune_releases() { # prune_releases VERSION_ANTERIOR(puede ser vacía)
  local prev=${1-} running d n=0
  [[ -d $RELEASES_DIR ]] || return 0
  running=$(running_release || true)
  while IFS= read -r -d '' d; do
    [[ ${d##*/} =~ $REL_ID_RE ]] || continue # lo que no es una versión no es nuestro: no se cuenta ni se toca
    n=$((n + 1))
    if (( n <= 3 )) || [[ $d == "$REL_DIR" || $d == "$prev" || ( -n $running && $d -ef $running ) ]]; then continue; fi
    if drop_release "$d"; then
      info "versión antigua borrada: ${d##*/}"
    else
      warn "no se pudo borrar la versión antigua $d"
    fi
  done < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -not -name '.tmp-*' -printf '%T@ %p\0' | sort -rnz | cut -zd' ' -f2-)
  while IFS= read -r -d '' d; do
    if drop_release "$d"; then info "temporal abandonado borrado: ${d##*/}"; fi
  done < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -name '.tmp-*' -mmin +60 -print0)
  return 0
}

render() { # render PLANTILLA DESTINO : sustituye @ROOT@, @BIN@, @SCRIPT@, @DIST@, @DATA@ y @OLLAMA@
  local ollama_bin
  ollama_bin="$(command -v ollama || printf /usr/bin/ollama)"
  sed -e "s|@ROOT@|$ROOT|g" -e "s|@BIN@|${REL_BIN:-$BIN}|g" -e "s|@SCRIPT@|${REL_SCRIPT:-$SELF_PATH}|g" \
    -e "s|@DIST@|${REL_DIST:-$ROOT/frontend/dist}|g" -e "s|@DATA@|$DATA_DIR|g" -e "s|@OLLAMA@|$ollama_bin|g" -- "$1" >"$2"
}

# La unidad da escritura (ReadWritePaths) a DATA_DIR: no puede ser `/` ni $HOME, ni cubrir el proyecto, las
# versiones instaladas o las unidades, ni estar dentro de las versiones (un proceso comprometido reescribiría
# su propio binario). prepare_files (run, dev, install…) lo comprueba antes de su mkdir y chmod 700 sobre DATA_DIR.
check_data_dir() {
  local data p
  data=$(realpath -m -- "$DATA_DIR")
  DATA_DIR=$data # normalizada: systemd ignora un ReadWritePaths con «..»
  if [[ $data == / || $data == "$(realpath -m -- "${HOME:-/}")" || $data == "$(realpath -m -- "$RELEASES_DIR")"/* ]]; then
    die "los datos ($DATA_DIR, de DATABASE_URL) no pueden ser / ni tu carpeta personal ni estar dentro de las versiones instaladas: usa una carpeta propia (por defecto data/ del proyecto)."
  fi
  for p in "$ROOT" "$RELEASES_DIR" "$UNIT_DIR"; do
    p=$(realpath -m -- "$p")
    if [[ $p == "$data" || $p == "$data"/* ]]; then
      die "los datos ($DATA_DIR, de DATABASE_URL) contienen $p: el servicio podría escribir ahí; usa una carpeta propia (por defecto data/ del proyecto)."
    fi
  done
}

cmd_install() {
  local autostart=0 build=1 a prev
  for a in "$@"; do
    case $a in
      --autostart) autostart=1 ;;
      --no-build) build=0 ;; # instala lo ya compilado (falla si falta)
      *) die "uso: ./invest-ai install [--autostart] [--no-build]" ;;
    esac
  done
  have systemctl || die "no hay systemd"
  check_prereqs
  prepare_files
  unit_safe "$ROOT" && unit_safe "$DATA_DIR" && unit_safe "$BIN" && unit_safe "$RELEASES_DIR" \
    || die "la ruta del proyecto, de los datos o de las versiones instaladas tiene caracteres que los ficheros de unidad no admiten; muévelos."
  if (( build )); then
    ensure_frontend 1
    ensure_backend release
  fi
  prev=$(installed_release || true)
  snapshot_release
  mkdir -p -- "$UNIT_DIR" "$APP_DIR" "$ICON_DIR"
  render "$ROOT/packaging/invest-ai.service" "$UNIT_DIR/$SERVICE"
  render "$ROOT/packaging/invest-ai-ollama.service" "$UNIT_DIR/$OLLAMA_SERVICE"
  render "$ROOT/packaging/invest-ai.desktop" "$APP_DIR/invest-ai.desktop"
  install -m 644 -- "$ROOT/packaging/invest-ai.svg" "$ICON_DIR/invest-ai.svg"
  chmod 644 -- "$UNIT_DIR/$SERVICE" "$UNIT_DIR/$OLLAMA_SERVICE" "$APP_DIR/invest-ai.desktop"
  systemctl --user daemon-reload
  if (( autostart )); then
    systemctl --user enable "$SERVICE"
    ok "autoarranque activado (al iniciar sesión)"
  fi
  if have update-desktop-database; then update-desktop-database "$APP_DIR" 2>/dev/null || true; fi
  prune_releases "$prev"
  ok "instalado: $UNIT_DIR/$SERVICE (versión $(basename -- "$REL_DIR")) y entrada 'invest-ai' en el menú de KDE"
  if system_ollama_enabled; then
    info "hay un ollama.service del sistema habilitado: el Ollama de respaldo ($OLLAMA_SERVICE) no arrancará nunca (su ExecCondition lo omite); los modelos viven en el del sistema"
  fi
  if [[ -n $prev && $prev != "$REL_DIR" ]] && service_active; then
    info "el servicio en marcha sigue con la versión anterior ($(basename -- "$prev")); aplica la nueva con: systemctl --user restart $SERVICE"
  fi
  printf '  iniciar:      systemctl --user start %s   (o el icono del menú)\n' "$SERVICE"
  printf '  actualizar:   tras cambiar el código, ./invest-ai install y systemctl --user restart %s\n' "$SERVICE"
  printf '  autoarranque: ./invest-ai install --autostart\n'
  printf '  modelo:       el servicio nunca descarga modelos solo; ./invest-ai pull (o AUTO_PULL_MODEL=1 en .env)\n'
  printf '  endurecimiento: systemd-analyze --user security %s\n' "$SERVICE"
}

cmd_uninstall() {
  have systemctl || die "no hay systemd"
  systemctl --user disable --now "$SERVICE" 2>/dev/null || true
  systemctl --user stop "$OLLAMA_SERVICE" 2>/dev/null || true
  rm -f -- "${UNIT_DIR:?}/$SERVICE" "${UNIT_DIR:?}/$OLLAMA_SERVICE" "${APP_DIR:?}/invest-ai.desktop" "${ICON_DIR:?}/invest-ai.svg"
  if [[ -d $RELEASES_DIR ]]; then
    chmod -R -P u+w -- "$RELEASES_DIR" && rm -rf -- "${RELEASES_DIR:?}"
    rmdir --ignore-fail-on-non-empty -- "$(dirname -- "$RELEASES_DIR")" 2>/dev/null || true
  fi
  systemctl --user daemon-reload
  if have update-desktop-database; then update-desktop-database "$APP_DIR" 2>/dev/null || true; fi
  ok "desinstalado, incluidas las versiones instaladas (los datos de data/ y .env no se tocan)"
}

# Abre la app: si no corre, arranca el servicio (si está instalado) o el modo normal. Lo usa el .desktop.
cmd_open() {
  load_settings
  if app_up; then open_url "$APP_URL"; return 0; fi
  if service_installed; then
    systemctl --user start "$SERVICE"
    wait_for 120 app_up || die "el servicio no respondió (journalctl --user -u $SERVICE)"
    open_url "$APP_URL"
  else
    cmd_run
  fi
}

# Segundos que _prestart espera a Ollama antes de dejar arrancar la app sin él (INVEST_AI_PRESTART_WAIT
# lo cambia; lo usan las pruebas de packaging/test-invest-ai.sh).
PRESTART_OLLAMA_WAIT="${INVEST_AI_PRESTART_WAIT:-30}"
[[ $PRESTART_OLLAMA_WAIT =~ ^[0-9]{1,4}$ ]] || PRESTART_OLLAMA_WAIT=30
readonly PRESTART_OLLAMA_WAIT

# Previo al servicio (ExecStartPre): valida .env y, si Ollama responde, comprueba el modelo.
# NUNCA bloquea el arranque por falta de Ollama (la UI y los datos funcionan sin LLM, los análisis
# fallan con un error claro y la lista de seguimiento espera y reintenta) y NUNCA descarga un
# modelo salvo con AUTO_PULL_MODEL=1 en .env.
cmd_prestart() {
  load_settings # falla (y sí impide el arranque) si BIND_ADDR no es loopback
  if (( FAKE )); then return 0; fi
  if ! ollama_up; then
    info "esperando hasta ${PRESTART_OLLAMA_WAIT} s a Ollama en $LLM_BASE_URL"
    if ! wait_for "$PRESTART_OLLAMA_WAIT" ollama_up; then
      warn "Ollama no responde en $LLM_BASE_URL: arranco la app igualmente; los análisis fallarán hasta que Ollama esté en marcha"
      return 0
    fi
  fi
  ensure_model 0
}

# pull [MODELO]: descarga un modelo (por defecto LLM_MODEL) en el Ollama de LLM_BASE_URL.
cmd_pull() {
  local model=${1-} rc=0
  load_settings
  have ollama || die "falta ollama (sudo pacman -S ollama)."
  model=${model:-$LLM_MODEL}
  ollama_up || die "Ollama no responde en $LLM_BASE_URL: arráncalo (sudo systemctl start ollama) y repite."
  model_state "$model" || rc=$?
  if (( rc == 0 )); then
    ok "el modelo $model ya está instalado en $LLM_BASE_URL"
    return 0
  fi
  pull_model "$model" || exit 1
}

# selftest [--llm] [--url URL]: prueba de humo (health, cotizaciones reales, tick WS, /models,
# cabeceras). Usa la instancia en marcha; si no hay, arranca una temporal en un puerto libre.
cmd_selftest() {
  local llm=() url="" tmp="" pid="" port
  while (( $# )); do
    case $1 in
      --llm) llm=(--llm) ;;
      --url) shift; url=${1:-} ;;
      *) die "selftest: opción desconocida: $1" ;;
    esac
    shift
  done
  mkdir -p -- "$STATE_DIR"
  prepare_files
  have curl || die "falta curl"
  if [[ -z $url ]]; then
    if app_up; then
      url=$APP_URL
      info "selftest contra la instancia en marcha ($url)"
    else
      ensure_backend release
      for port in $(seq 18787 18887); do port_busy "$port" || break; done
      tmp=$(mktemp -d)
      info "no hay instancia: arranco una temporal en 127.0.0.1:$port"
      (
        cd -- "$ROOT"
        BIND_ADDR="127.0.0.1:$port" DATABASE_URL="sqlite://$tmp/selftest.db" \
          setsid "$BIN" >"$tmp/server.log" 2>&1 9>&- &
        echo $! >"$tmp/pid"
      )
      pid=$(<"$tmp/pid")
      url="http://127.0.0.1:$port"
      # shellcheck disable=SC2064
      trap "kill_group '$pid' 5; rm -rf -- '$tmp'" EXIT
      wait_for 20 curl -fsS --max-time 2 -o /dev/null "$url/api/health" 2>/dev/null \
        || { cat -- "$tmp/server.log" >&2; die "la instancia temporal no arrancó"; }
    fi
  fi
  [[ -x $SELFTEST_BIN ]] || ensure_backend release
  local rc=0
  "$SELFTEST_BIN" "$url" ${llm[@]+"${llm[@]}"} || rc=$?
  return "$rc"
}

usage() {
  cat <<'USO'
Uso: ./invest-ai [opciones] [comando]

Comandos:
  (ninguno) | run   compila lo que haga falta, arranca Ollama + app y abre el navegador
  dev               backend (debug) + Vite con HMR en :5180; un solo Ctrl+C
  stop              para la app (y el Ollama que arrancó este script)
  status            estado de app, Ollama, modelo, servicio y compilación
  logs [-f] [server|ollama|vite]
  open              abre el navegador; arranca la app si no corre (lo usa el icono de KDE)
  pull [MODELO]     descarga un modelo en el Ollama en uso (por defecto LLM_MODEL). Es la única vía
                    por línea de comandos: ni el servicio ni run/dev descargan nada sin pedirlo
                    (AUTO_PULL_MODEL=1 en .env lo permite sin preguntar)
  install [--autostart] [--no-build]   compila, copia una versión inmutable a ~/.local/share/invest-ai/releases/
                    y deja el servicio systemd de usuario + la entrada de KDE apuntando a ella (las
                    builds posteriores del árbol de trabajo no la tocan; para actualizarla, repite install
                    y reinicia el servicio). --no-build instala lo ya compilado
  uninstall         quita servicio y entrada del menú
  selftest [--llm]  prueba de humo contra la instancia (o una temporal): sale con 1 si algo falla

Opciones:
  --fake            datos simulados (sin red ni Ollama)
  --no-browser      no abrir el navegador
USO
}

main() {
  local cmd="" args=() a
  for a in "$@"; do
    case $a in
      --fake) FAKE=1 ;;
      --no-browser) NO_BROWSER=1 ;;
      -h|--help) usage; exit 0 ;;
      *) if [[ -z $cmd ]]; then cmd=$a; else args+=("$a"); fi ;;
    esac
  done
  case ${cmd:-run} in
    run) cmd_run ;;
    dev) cmd_dev ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    logs) mkdir -p -- "$STATE_DIR"; load_settings; cmd_logs ${args[@]+"${args[@]}"} ;;
    open) cmd_open ;;
    pull) cmd_pull ${args[@]+"${args[@]}"} ;;
    install) cmd_install ${args[@]+"${args[@]}"} ;;
    uninstall) cmd_uninstall ;;
    selftest) cmd_selftest ${args[@]+"${args[@]}"} ;;
    _prestart) cmd_prestart ;;
    help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
