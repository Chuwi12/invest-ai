rnment markets. It distributes third-party applications for its products through the App Store. The company also sells its products through its retail and online stores, and direct sales force; and third-party cellular network carriers and resellers. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.","sector":"Technology","industry":"Consumer Electronics","website":"https://www.apple.com","employees":150000,"country":"United States","currency":"USD","marketCap":5005219725312.0,"enterpriseValue":5002500767744.0,"peTrailing":39.330273,"peForward":35.760014,"peg":2.73,"priceToBook":46.597824,"priceToSales":10.721879,"evToEbitda":29.784,"epsTrailing":8.72,"epsForward":9.5906,"revenueTtm":466822987776.0,"revenueGrowthYoy":0.164,"earningsGrowthYoy":0.287,"grossMargin":0.48653,"operatingMargin":0.32623002,"profitMargin":0.27618998,"roe":1.4875101,"roa":0.27082002,"freeCashFlow":107721875456.0,"totalCash":62399000576.0,"totalDebt":84343996416.0,"debtToEquity":0.78445,"currentRatio":1.003,"dividendYield":0.0032,"payoutRatio":0.1204,"beta":1.069,"sharesOutstanding":14594180000.0,"shortPctFloat":0.0083,"insiderPct":0.01648,"institutionalPct":0.66324997,"analystTargetMean":329.3759,"analystTargetHigh":405.0,"analystTargetLow":215.0,"analystRatingMean":2.20455,"analystCount":39,"nextEarningsDate":"2026-11-02","circulatingSupply":null,"totalSupply":null,"maxSupply":null,"fullyDilutedValuation":null,"allTimeHigh":null,"allTimeHighDate":null,"expenseRatio":null,"totalAssets":null,"topHoldings":[],"yieldToMaturity":null,"coupon":null,"maturityDate":null,"extra":{"averageVolume":45038190.0,"bookValue":7.36,"ebitda":167959003136.0,"exDividendDate":"2026-08-10","financialCurrency":"USD","operatingCashflow":146723995648.0,"quickRatio":0.812,"recommendationKey":"buy"},"sources":["yahoo"],"asOf":"2026-10-14T20:54:15.866245838Z","sourceUrl":"https://finance