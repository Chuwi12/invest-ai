[Unit]
Description=Ollama de respaldo para invest-ai (solo si no hay ollama.service del sistema ni nadie en :11434)
After=network.target

[Service]
Type=simple
# Es un RESPALDO: se omite sin error (exec-condition) si ya hay un Ollama o va a haberlo.
# 1) Si hay uno escuchando en :11434, no se pisa.
# 2) Si existe un ollama.service del SISTEMA habilitado, tampoco arranca NUNCA, aunque su puerto aún
#    esté libre: al arrancar el equipo (linger) esta unidad de usuario se adelantaba, se quedaba el
#    puerto y el Ollama del sistema moría con «address already in use» (RestartPreventExitStatus=1,
#    sin reintento) dejando los modelos de /var/lib/ollama inaccesibles; el de usuario tiene el
#    almacén ~/.ollama vacío. Se evalúa en cada arranque, así que sigue valiendo si el usuario
#    habilita o deshabilita ollama.service más tarde (docs/notes/ops.md, «carrera de los dos Ollama»).
ExecCondition=/usr/bin/bash -c '! { exec 3<>/dev/tcp/127.0.0.1/11434; } 2>/dev/null'
ExecCondition=/usr/bin/bash -c '! /usr/bin/systemctl --system is-enabled --quiet ollama.service'
ExecStart=@OLLAMA@ serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=on-failure
RestartSec=3
# Ollama necesita /dev/nvidia* y escribir en ~/.ollama (modelos): endurecimiento moderado.
# ~/.ollama puede no existir (con Ollama como servicio del sistema los modelos están en
# /var/lib/ollama): `ReadWritePaths` a una ruta ausente hacía fallar la unidad en NAMESPACE (226)
# y el ExecCondition lo enmascaraba como «condición no cumplida», así que nunca arrancaba. Se crea
# antes del arranque, fuera de la jaula (prefijo `+`), y el `-` tolera que falte en el ExecCondition.
ExecStartPre=+/usr/bin/mkdir -p -m 700 %h/.ollama
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-%h/.ollama
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
